# Auth0 SPA credentials, from Applications > your app in the Auth0 dashboard.
# Both values ship in the browser bundle, so neither is a secret. The client
# SECRET is never used by a SPA: don't put it here.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
# The Identifier of your own API in the Auth0 dashboard. Must match
# AUTH0_AUDIENCE in api/.env exactly.
VITE_AUTH0_AUDIENCE=https://api.healthher.app
