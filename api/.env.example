# Copy to .env and fill in your local MySQL credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=herbalance
PORT=3001
DEMO_EMAIL=demo@healthher.app

# Auth0. AUTH0_AUDIENCE must match the Identifier of the API you created in
# the Auth0 dashboard, character for character, and the audience the web app
# asks for in web/.env. This is your OWN API, not Auth0's Management API.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.healthher.app
